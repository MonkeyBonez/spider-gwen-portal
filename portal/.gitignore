# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — the Decart API key lives in .env.local, which never gets committed.
# The root .gitignore covers this too; it is repeated here so anyone working
# inside portal/ can see the rule without leaving the directory. `.env.example`
# is the template and is deliberately tracked, so it must stay key-free.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
