# Copy this file to `.env.local` and paste your key there. `.env.local` is
# gitignored; this file is not, so never put a real key in here.
#
#     cp .env.example .env.local
#
# Get a key from https://platform.decart.ai/ . New accounts come with free
# trial credits — use those before spending (PRD §7).

# --- Local development only ------------------------------------------------
# Vite INLINES every `VITE_`-prefixed variable into the built JavaScript. That
# is fine on localhost, where the bundle never leaves your machine, and it is
# why this must never be set in a build you deploy or hand to anyone: the key
# would be sitting in plain text inside the published bundle.
#
# For anything beyond local dev the app reads the key from localStorage
# instead, entered by whoever is using it (PRD Phase 2, "BYO key"). Leave this
# blank and the app falls back to that path, which is also how you test the
# real flow.
VITE_DECART_API_KEY=
